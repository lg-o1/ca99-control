name: Deploy Piano to SWA

on:
  push:
    branches: [main]
    paths-ignore:
      - 'app/midi-collection/sheets/**/*.png'
      - 'app/midi-collection/sheets/**/*.pdf'
      - 'app/midi-collection/midi/**'

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          sparse-checkout: |
            app
            deploy
          sparse-checkout-cone-mode: true

      - name: Build deploy directory
        run: |
          mkdir -p _site/piano
          # Portal root (landing page)
          cp deploy/index.html _site/index.html
          # Piano app (exclude sheet images and MIDI files)
          rsync -a --exclude='sheets/*/[0-9]*.png' \
                   --exclude='sheets/*/*.pdf' \
                   --exclude='midi-collection/midi/' \
                   app/ _site/piano/
          # Keep only sheets/index.json (small), remove image dirs
          find _site/piano/midi-collection/sheets -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} + 2>/dev/null || true
          echo "Deploy size:"
          du -sh _site/

      - name: Deploy
        uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN }}
          repo_token: ${{ secrets.GITHUB_TOKEN }}
          action: "upload"
          app_location: "/_site"
          output_location: ""
          skip_app_build: true
