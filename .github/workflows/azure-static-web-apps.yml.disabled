name: Azure Static Web Apps CI/CD

on:
  push:
    branches:
      - main
    paths-ignore:
      - 'app/midi-collection/sheets/**/*.png'
      - 'app/midi-collection/sheets/**/*.pdf'

jobs:
  build_and_deploy:
    runs-on: ubuntu-latest
    name: Build and Deploy
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: false
          sparse-checkout: |
            /*
            !/app/midi-collection/sheets/*/
          sparse-checkout-cone-mode: false

      - name: Verify size
        run: |
          ls app/midi-collection/sheets/ 2>/dev/null || echo "No sheets dir"
          du -sh app/

      - name: Deploy
        uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN }}
          repo_token: ${{ secrets.GITHUB_TOKEN }}
          action: "upload"
          app_location: "/app"
          output_location: ""
          skip_app_build: true
